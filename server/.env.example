# ─────────────────────────────────────────────────────────────────────────────
# SERVER ENVIRONMENT — template only. Contains NO secrets.
#
# Copy to `server/.env` for local dev. For Render, set these in
# Dashboard → your service → Environment, NOT in this file.
#
#   cp .env.example .env
#
# Every value below is read by the code. Nothing is hardcoded.
# ───────────────────────────────────────────���─────────────────────────────────

# ── RUNTIME ───────────────────────────────────────────────────────────────────
# Must be exactly one of: development | production | test
# The server REFUSES TO BOOT if this is missing or misspelled — an unset
# NODE_ENV silently selects the permissive branch in the cookie Secure flag,
# the CORS LAN allowlist, the OTP console-log, and the https:// photo check.
NODE_ENV=development

# Port. Render injects this automatically — do not set it in the dashboard.
# The value below is the local-dev default.
PORT=5005

# ── DATABASE (required) ───────────────────────────────────────────────────────
# Atlas SRV string. Must NOT include the literal "<password>" placeholder —
# urlencode special characters in the password (e.g. @ → %40).
# Free M0 tier works: 512 MB shared, which is fine for an early cohort.
# Local dev used mongodb://127.0.0.1:27017/matchalize; that fallback has been
# removed on purpose so a missing value fails loudly instead of silently
# creating a second, empty local database.
#
#   MongoDB Atlas → Connect → Drivers → Node.js → copy the SRV string
MONGODB_URI=

# ── AUTH SECRETS (required) ───────────────────────────────────────────────────
# Signs the 7-day session JWT held in the httpOnly cookie.
# Generate: openssl rand -base64 48
# Rotating this invalidates every existing session — all users log out.
JWT_SECRET=

# HMAC key for OTP fingerprints. OTP codes are stored hashed, never plaintext.
# Falls back to JWT_SECRET if unset (the server warns), but give it its own
# value so rotating JWT sessions does not also rotate OTP hashes.
# Generate: openssl rand -base64 48
OTP_HASH_SECRET=

# ── FRONTEND ORIGIN (required in production) ─────────────────────────────────
# The deployed client URL, scheme included, no trailing slash.
# Drives BOTH the CORS allowlist and the CSP connect-src list.
# In production this is the ONLY origin allowed — localhost is not added.
#   Render static site → https://<your-service>.onrender.com
FRONTEND_URL=http://localhost:5173

# ── EMAIL / OTP DELIVERY (Resend) ─────────────────────────────────────────────
# Without this key the server still boots but prints OTP codes to stdout
# instead of emailing them. No user can onboard, so set it in production.
#   Resend → API Keys → Create API key
RESEND_API_KEY=

# ⚠️ BARE ADDRESS ONLY — no display name, no angle brackets.
# The header is composed as `NAME <ADDRESS>` in utils/email.js, so writing
# "huh? <otp@huh.app>" here yields "huh? <huh? <otp@huh.app>>" and Resend
# rejects it. Every OTP then silently never arrives.
#
# MUST be a domain you have VERIFIED in Resend (Domains → Add Domain → add the
# DNS records it shows). The default below is Resend's sandbox sender, which
# delivers ONLY to the address that owns the Resend account — real students
# receive nothing, and no error is raised.
RESEND_SENDER_EMAIL=onboarding@resend.dev

# Display name and the brand shown inside the emails. Keep these in sync with
# the landing page — the templates render this name, not a hardcoded one.
RESEND_SENDER_NAME=huh?

# ── MEDIA UPLOADS (Cloudinary) ────────────────────────────────────────────────
# Without these, photo uploads fail at runtime.
#   Cloudinary → Dashboard → copy Cloud name, API key, API secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WEB PUSH (VAPID) ──────────────────────────────────────────────────────────
# Both or neither. Without them push notifications are disabled and the app
# falls back to in-app notifications only.
# Generate once and keep the pair together — regenerating invalidates every
# existing Push subscription, so all users must re-enable notifications.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── ERROR MONITORING (Sentry) ─────────────────────────────────────────────────
# Optional. Sentry.init() only runs when this is set.
#   Sentry → Project Settings → Client Keys → DSN
SENTRY_DSN=

# ── ADMIN ACCESS ─────────────────────────────────────────────────────────────
# The email allowed to reach the admin panel and admin API routes.
ADMIN_EMAIL=

# ── CAMPUS GATE ─────────────────────────────────────────────────────────────
# Comma-separated college CODES permitted to sign up. Leave EMPTY for no gate —
# every active college can then register, which is the correct default for
# local dev.
#
# For an IIT Bombay pilot, set exactly:
#
#   ALLOWED_COLLEGES=iitb
#
# Enforced on the server at signup (routes/auth.js), so it cannot be bypassed by
# posting a collegeCode directly. Gated-out campuses are also hidden from the
# picker, because showing a selectable college that signup then rejects is the
# worst place to hit a closed door.
#
# This is separate from College.active in the database on purpose: the database
# is mutable at runtime by an operator from /admin, and a pilot gate that an
# admin click can switch off is not a gate. This only changes on redeploy.
#
# NOTE: the campus a student belongs to is NOT editable after signup except via
# the change-college flow, which re-runs the same check.
#
# To open the next campus, add its code and redeploy — e.g.
#   ALLOWED_COLLEGES=iitb,iitd
ALLOWED_COLLEGES=

# ── RATE LIMITS (optional overrides) ──────────────────────────────────────────
# Defaults live in config/appData.js. Set only to tune, never to disable.
# Deliberately generous: campus NAT means an entire hostel shares one public
# IP, so an aggressive limit locks out a whole building.
API_GENERAL_MAX=1000
OTP_EMAIL_LIMIT_MAX=5
OTP_VERIFY_MAX=3
WAITLIST_JOIN_MAX=5
COLLEGE_REQUEST_LIMIT_MAX=3
REVERIFY_MAX=2

# ── LANDING COPY (optional) ───────────────────────────────────────────────────
# Overrides used by the marketing landing page.
SPLASH_TAGLINE=
SPLASH_VIDEO_URL=